# Pavilion runtime config.
#
# VITE_APP_MODE selects the data backend:
#   demo (default) → in-memory MockRepository; Supabase is tree-shaken out.
#   live           → SupabaseRepository (Phase 2), using the vars below.
VITE_APP_MODE=demo

# Supabase — pavilion-dev. The publishable key is designed to ship in the client
# bundle; row-level security protects the data, not key secrecy. (Never commit
# the service_role key.)
VITE_SUPABASE_URL=https://fkbnnycgbqvqnljcwrdy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YxLvMonvvrtUfniYCGnocg_KSPtmrdd
